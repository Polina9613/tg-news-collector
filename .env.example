TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+79001234567
TELEGRAM_SESSION_NAME=tg_news
DB_PATH=data/tg_news.db
SOURCES_FILE=sources.yaml
LOG_LEVEL=INFO
DEFAULT_COLLECT_DAYS=7
MIN_RELEVANCE_SCORE=30

# ── Основной LLM-провайдер ────────────────────────────────────────────────────
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=ключ_основного_провайдера
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=120
LLM_MIN_SCORE=40

# ── Резервный провайдер (Groq) ────────────────────────────────────────────────
# Используется если основной провайдер недоступен или возвращает ошибку.
# Оставьте пустым если fallback не нужен.
GROQ_FALLBACK_API_KEY=gsk_xxx
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ── Ollama (свой сервер, LLM_PROVIDER=ollama) ─────────────────────────────────
# LLM_BASE_URL=http://your-server.com:11434
# LLM_MODEL=qwen2.5:14b

# ── Yandex AI Studio (LLM_PROVIDER=yandex) ───────────────────────────────────
# YANDEX_API_KEY=ваш_api_key
# YANDEX_FOLDER_ID=ваш_folder_id
# YANDEX_MODEL=aliceai-llm/latest

# ── Telegram-бот ──────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather
BOT_ADMIN_SECRET=ваше_длинное_кодовое_слово_для_админов
